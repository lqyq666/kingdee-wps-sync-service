# Runtime
APP_HOST=0.0.0.0
APP_PORT=8080
# Host-facing port used only by the local Compose demo.
HOST_PORT=28080
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://sync_user@postgres:5432/kingdee_wps_sync
SYNC_BATCH_SIZE=100
SYNC_OVERLAP_MINUTES=15
SYNC_LOCK_TTL_SECONDS=900
SYNC_MAX_ATTEMPTS=3
SYNC_RETRY_BASE_SECONDS=0.25

# Mock mode is the only supported mode without tenant credentials.
KINGDEE_MODE=mock
WPS_MODE=mock

# Real Kingdee integration — leave empty until a tenant's API contract and metadata are available.
KINGDEE_BASE_URL=
KINGDEE_APP_ID=
KINGDEE_APP_SECRET=
KINGDEE_FORM_ID=
KINGDEE_SYNC_URL=
KINGDEE_SOURCE_ID_FIELD=
KINGDEE_SOURCE_MODIFIED_AT_FIELD=
KINGDEE_KSO_SECRET=

# Real WPS integration — leave empty until a WPS application and target table are provisioned.
# WPS 365 OpenAPI defaults are official public endpoints, not credentials.
WPS_BASE_URL=https://openapi.wps.cn
WPS_APP_ID=
WPS_APP_SECRET=
WPS_FILE_ID=
WPS_SHEET_ID=
WPS_TOKEN_URL=https://openapi.wps.cn/oauth2/token
# Enable only when the WPS application has "接口签名" enabled. AppSecret is the KSO-1 secret key.
WPS_KSO_SIGNING_ENABLED=false
# Legacy optional override. Leave empty for a standard self-built WPS application.
WPS_KSO_SECRET=

# Optional operational alert endpoint. Do not put a production URL in the repository.
ALERT_WEBHOOK_URL=

# Kingdoc (kdocs.cn) open platform - separate from WPS 365; used when WPS_PROVIDER=kdocs
WPS_PROVIDER=wps365
KDOCS_APP_ID=
KDOCS_AK=
KDOCS_SK=
